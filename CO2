
:root {
  --background: #07140f;
  --panel: #10251b;
  --green: #55e69a;
  --green-dark: #15975a;
  --text: #effff5;
  --muted: #a9c4b4;
}

* {
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Arial, sans-serif;
  line-height: 1.7;
}

header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 17px 6%;
  background: #07140ff2;
  border-bottom: 1px solid #294435;
  gap: 15px;
  flex-wrap: wrap;
}

.logo {
  font-size: 21px;
  font-weight: bold;
  color: white;
  text-decoration: none;
}

.logo span {
  color: var(--green);
}

nav {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

nav a {
  color: var(--text);
  text-decoration: none;
  font-size: 13px;
}

nav a:hover,
.source-list a:hover {
  color: var(--green);
}

.hero {
  min-height: 620px;
  display: flex;
  align-items: center;
  padding: 70px 9%;
  background:
    linear-gradient(90deg, #07140ff5, #07140f70),
    url("https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=1800")
    center/cover;
}

.hero-content {
  max-width: 760px;
}

.eyebrow,
.heading span {
  color: var(--green);
  letter-spacing: 3px;
  font-size: 12px;
  font-weight: bold;
}

.hero h1 {
  font-size: clamp(42px, 7vw, 80px);
  line-height: 1.08;
}

.hero h1 span {
  color: var(--green);
}

.hero p {
  font-size: 19px;
  color: #d5e8dc;
}

.button {
  display: inline-block;
  border: 0;
  border-radius: 8px;
  padding: 14px 24px;
  margin-top: 15px;
  background: var(--green-dark);
  color: white;
  text-decoration: none;
  font-weight: bold;
  cursor: pointer;
  transition: .25s;
}

.button:hover {
  background: #21bd71;
  transform: translateY(-3px);
}

section {
  padding: 85px 8%;
  scroll-margin-top: 80px;
}

.dark {
  background: #0b1e15;
}

.heading {
  margin-bottom: 40px;
}

.heading h2 {
  font-size: clamp(29px, 4vw, 43px);
  margin: 10px 0;
}

.heading p,
.muted,
.small {
  color: var(--muted);
}

.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 35px;
  align-items: center;
}

.rounded {
  width: 100%;
  border-radius: 14px;
  object-fit: cover;
  max-height: 390px;
}

.info {
  background: #153a29;
  border-left: 4px solid var(--green);
  padding: 20px;
  border-radius: 7px;
  margin: 25px 0;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 22px;
  margin-top: 30px;
}

.card {
  background: var(--panel);
  border: 1px solid #294737;
  border-radius: 13px;
  padding: 25px;
  transition: .3s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--green);
}

.card h3 {
  color: var(--green);
  margin-top: 0;
}

.card p {
  color: #c5d8cb;
}

.image-cards .card {
  padding: 0;
  overflow: hidden;
}

.image-cards img {
  width: 100%;
  height: 190px;
  object-fit: cover;
}

.card-body {
  padding: 22px;
}

.big-stat {
  padding: 35px;
  text-align: center;
  background: linear-gradient(135deg, #12472d, #10251b);
  border-radius: 15px;
  margin: 30px 0;
}

.big-stat strong {
  display: block;
  color: var(--green);
  font-size: clamp(55px, 10vw, 95px);
  line-height: 1.2;
}

.big-stat span {
  font-size: 20px;
}

.chart {
  margin: 35px 0;
}

.chart-row {
  display: grid;
  grid-template-columns: minmax(120px, 1fr) 2fr 55px;
  gap: 15px;
  align-items: center;
  margin: 20px 0;
  font-size: 14px;
}

.chart-row b {
  color: var(--green);
}

.track {
  background: #243d30;
  height: 13px;
  border-radius: 20px;
  overflow: hidden;
}

.track div {
  height: 100%;
  background: linear-gradient(90deg, #16894d, #65efa4);
  border-radius: 20px;
  animation: grow 1.3s ease;
}

@keyframes grow {
  from { width: 0; }
}

.calculator,
.quiz {
  background: var(--panel);
  border: 1px solid #34533e;
  border-radius: 15px;
  padding: 30px;
  max-width: 850px;
}

.calculator label {
  display: block;
  margin-top: 22px;
  color: var(--green);
  font-weight: bold;
}

.calculator input {
  width: 100%;
  padding: 14px;
  background: #07140f;
  border: 1px solid #41644b;
  border-radius: 7px;
  color: white;
  font-size: 17px;
  margin-top: 8px;
}

#result {
  margin-top: 30px;
  padding: 25px;
  background: #0b3621;
  border-radius: 10px;
}

#total {
  display: block;
  color: var(--green);
  font-size: 40px;
  font-weight: bold;
}

details {
  padding: 20px;
  margin: 13px 0;
  background: var(--panel);
  border: 1px solid #294737;
  border-radius: 9px;
}

summary {
  color: var(--green);
  font-weight: bold;
  cursor: pointer;
}

.quiz-top {
  display: flex;
  justify-content: space-between;
  color: var(--green);
  gap: 15px;
}

.quiz-progress {
  height: 9px;
  background: #294737;
  border-radius: 10px;
  margin: 20px 0;
  overflow: hidden;
}

#quiz-bar {
  height: 100%;
  width: 0;
  background: var(--green);
  transition: .3s;
}

#answers button {
  display: block;
  width: 100%;
  padding: 14px;
  margin: 10px 0;
  text-align: left;
  border: 1px solid #41644b;
  background: #183326;
  color: white;
  border-radius: 8px;
  cursor: pointer;
}

#answers button:hover {
  border-color: var(--green);
}

#answers button.correct {
  background: #17683b;
}

#answers button.wrong {
  background: #762f34;
}

#feedback {
  min-height: 30px;
  font-weight: bold;
  color: var(--green);
}

.source-list {
  background: var(--panel);
  padding: 25px;
  border-radius: 12px;
}

.source-list a {
  color: var(--green);
}

footer {
  background: #040c08;
  text-align: center;
  padding: 45px 8%;
  border-top: 1px solid #294737;
}

footer p {
  color: var(--muted);
}

@media(max-width: 750px) {
  header {
    justify-content: center;
  }

  nav {
    justify-content: center;
    gap: 12px;
  }

  .split {
    grid-template-columns: 1fr;
  }

  section {
    padding: 60px 6%;
  }

  .hero {
    min-height: 500px;
    padding: 45px 7%;
  }

  .chart-row {
    grid-template-columns: 1fr 55px;
  }

  .chart-row .track {
    grid-column: 1 / -1;
    grid-row: 2;
  }
}
